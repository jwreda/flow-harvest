/*
 * FlowKit GUI Theme - Pink & Modern
 *
 * Color Palette:
 * - Primary: #FF69B4 (Hot Pink)
 * - Primary Hover: #FF1493 (Deep Pink)
 * - Primary Pressed: #DB1493 (Darker Pink)
 * - Background: #FFFFFF (White)
 * - Surface: #F8F9FA (Light Gray)
 * - Border: #E0E0E0 (Soft Gray)
 * - Text Primary: #333333 (Dark Gray)
 * - Text Secondary: #666666 (Medium Gray)
 * - Selection: #FFE4EC (Pink Tinted)
 * - Alt Row: #FFF5F8 (Very Light Pink)
 */

/* ===== Main Window ===== */
QMainWindow {
    background-color: #FFFFFF;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
    color: #333333;
}

/* ===== Menu Bar ===== */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 4px 8px;
    spacing: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #FFE4EC;
    color: #FF1493;
}

QMenuBar::item:pressed {
    background-color: #FF69B4;
    color: white;
}

/* ===== Menus ===== */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px 4px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 4px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: #FFE4EC;
    color: #FF1493;
}

QMenu::separator {
    height: 1px;
    background-color: #E0E0E0;
    margin: 6px 12px;
}

/* ===== Toolbar ===== */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    spacing: 8px;
    padding: 8px;
}

QToolBar::separator {
    width: 1px;
    background-color: #E0E0E0;
    margin: 4px 8px;
}

/* ===== Buttons - Primary ===== */
QPushButton#exportButton,
QPushButton#mainExportButton {
    background-color: #FF69B4;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton#exportButton:hover,
QPushButton#mainExportButton:hover {
    background-color: #FF1493;
}

QPushButton#exportButton:pressed,
QPushButton#mainExportButton:pressed {
    background-color: #DB1493;
}

QPushButton#exportButton:disabled,
QPushButton#mainExportButton:disabled {
    background-color: #E0E0E0;
    color: #999999;
}

/* ===== Buttons - Secondary ===== */
QPushButton {
    background-color: white;
    color: #FF69B4;
    border: 2px solid #FF69B4;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #FFF5F8;
    border-color: #FF1493;
    color: #FF1493;
}

QPushButton:pressed {
    background-color: #FFE4EC;
    border-color: #DB1493;
    color: #DB1493;
}

QPushButton:disabled {
    background-color: #F8F9FA;
    border-color: #E0E0E0;
    color: #999999;
}

/* ===== Group Boxes ===== */
QGroupBox {
    background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    margin-top: 20px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    color: #FF69B4;
    font-weight: 600;
    font-size: 13px;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 6px;
    padding: 0 6px;
    background-color: #F8F9FA;
}

/* ===== Tree View ===== */
QTreeView {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    selection-background-color: #FFE4EC;
    alternate-background-color: #FFF5F8;
    outline: none;
}

QTreeView::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeView::item:selected {
    background-color: #FFE4EC;
    color: #FF1493;
}

QTreeView::item:hover {
    background-color: #FFF5F8;
}

QTreeView::branch:has-children:closed {
    border-image: none;
}

QTreeView::branch:has-children:open {
    border-image: none;
}

/* Gate tree view - let custom delegate handle all item painting */
QTreeView#gateTreeView::item {
    background: transparent;
}

QTreeView#gateTreeView::item:selected {
    background: transparent;
}

QTreeView#gateTreeView::item:hover {
    background: transparent;
}

/* ===== Table View ===== */
QTableView {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    selection-background-color: #FFE4EC;
    alternate-background-color: #FFF5F8;
    gridline-color: #E0E0E0;
    outline: none;
}

QTableView::item {
    padding: 6px 8px;
}

QTableView::item:selected {
    background-color: #FFE4EC;
    color: #FF1493;
}

QHeaderView::section {
    background-color: #F8F9FA;
    color: #666666;
    font-weight: 600;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    border-right: 1px solid #E0E0E0;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-right: none;
    border-top-right-radius: 6px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    spacing: 8px;
    color: #333333;
    background-color: transparent;
    padding: 2px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #E0E0E0;
    border-radius: 4px;
    background-color: white;
}

QCheckBox::indicator:hover {
    border-color: #FF69B4;
}

QCheckBox::indicator:checked {
    background-color: #FF69B4;
    border-color: #FF69B4;
}

QCheckBox::indicator:checked:hover {
    background-color: #FF1493;
    border-color: #FF1493;
}

/* ===== Radio Buttons ===== */
QRadioButton {
    spacing: 8px;
    color: #333333;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #E0E0E0;
    border-radius: 10px;
    background-color: white;
}

QRadioButton::indicator:hover {
    border-color: #FF69B4;
}

QRadioButton::indicator:checked {
    background-color: #FF69B4;
    border-color: #FF69B4;
}

QRadioButton::indicator:checked:hover {
    background-color: #FF1493;
    border-color: #FF1493;
}

/* ===== Combo Boxes ===== */
QComboBox {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 30px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #FF69B4;
}

QComboBox:focus {
    border-color: #FF69B4;
    border-width: 2px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    selection-background-color: #FFE4EC;
    selection-color: #FF1493;
    padding: 4px;
}

/* ===== Scroll Bars ===== */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 4px 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #E0E0E0;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FF69B4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 2px 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #E0E0E0;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FF69B4;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== Scroll Area ===== */
QScrollArea {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}

/* Marker scroll area - borderless, inherits group background */
QScrollArea#markerScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#markerScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QWidget#markerContainer {
    background-color: transparent;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #E0E0E0;
    width: 2px;
    margin: 0 4px;
}

QSplitter::handle:hover {
    background-color: #FF69B4;
}

/* ===== Status Bar ===== */
QStatusBar {
    background-color: #F8F9FA;
    border-top: 1px solid #E0E0E0;
    color: #666666;
    padding: 4px 12px;
    font-size: 11px;
}

/* ===== Labels ===== */
QLabel#headerLabel {
    font-weight: 700;
    font-size: 14px;
    color: #FF69B4;
}

/* ===== Progress Dialog ===== */
QProgressDialog {
    background-color: white;
}

QProgressBar {
    background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    text-align: center;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #FF69B4;
    border-radius: 5px;
}

/* ===== Message Boxes ===== */
QMessageBox {
    background-color: white;
}

QMessageBox QLabel {
    color: #333333;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 30px;
}

/* ===== File Dialog ===== */
QFileDialog {
    background-color: white;
}

/* ===== Tooltips ===== */
QToolTip {
    background-color: #333333;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ===== Tab Widget ===== */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    background-color: white;
    margin-top: -1px;
    padding: 12px;
}

QTabWidget::tab-bar {
    left: 8px;
}

QTabBar::tab {
    background-color: #F8F9FA;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    margin-right: 4px;
    color: #666666;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: white;
    color: #FF69B4;
    font-weight: 600;
    border-bottom: 1px solid white;
    margin-bottom: -1px;
}

QTabBar::tab:hover:!selected {
    background-color: #FFE4EC;
    color: #FF1493;
}

QTabBar::tab:first {
    margin-left: 0;
}

/* ===== Focus Indicators ===== */
*:focus {
    outline: none;
}
